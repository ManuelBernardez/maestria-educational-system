# MaestrIA — configuración local. Copiar como backend/.env y completar.
# En producción, cargar los mismos valores en el panel Environment del hosting.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# PostgreSQL de Supabase. Render es un backend persistente: para IPv4, preferí Shared Pooler (session mode, puerto 5432).
# Copiá la URI exacta desde Supabase > Connect > Shared Pooler; no compartas la contraseña.
# Transaction mode (6543) es otra opción, pero no admite prepared statements.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@[POOLER-HOST]:5432/postgres?sslmode=require
# Segundos que vive una conexión persistente antes de renovarse (0 = una por pedido).
# No cambia cuántas conexiones hay abiertas (máximo workers × threads por instancia).
# DB_CONN_MAX_AGE=600

# Supabase Auth: URL y anon/publishable key son públicas; RLS debe estar bien configurado.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Secreto privado de firma JWT, solo si la validación configurada lo requiere.
SUPABASE_JWT_SECRET=

# Mismo origen en producción; estos orígenes se reservan para el preview local separado.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# IA: Gemini se invoca exclusivamente desde el backend.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: otro modelo de Gemini que se prueba UNA vez si el principal sigue saturado
# (HTTP 503 «UNAVAILABLE») después de los reintentos automáticos. Vacío = sin respaldo.
# Usá un modelo habilitado en tu proyecto de Google AI Studio.
GEMINI_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_ANSWERS=3
# Generaciones de IA simultáneas por proceso de Gunicorn (el resto de los hilos atiende
# HTML/API). Si no se libera un cupo en AI_SLOT_WAIT_SECONDS, la API responde 503.
AI_MAX_CONCURRENT_REQUESTS=2
AI_SLOT_WAIT_SECONDS=5
# Cuota por docente en 24 h, contada en public.ai_generation (0 = sin cuota).
AI_DAILY_LIMIT_PER_USER=300
# Tope total para generar consignas y rúbricas (la corrección usa 120 s).
AI_SUGGESTION_DEADLINE_SECONDS=100

# Cabeceras de IP de cliente confiables, en orden. En producción (Cloudflare delante de
# Render) el valor por defecto es True-Client-IP,CF-Connecting-IP. En local, vacío.
TRUSTED_CLIENT_IP_HEADERS=

# Proveedores alternativos (no necesarios para Gemini).
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Listados: 20 por página por defecto; el cliente puede pedir hasta 100.
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# Logs, auditoría y operaciones de la API.
# AI_MAX_CONCURRENT_ANSWERS limita el paralelismo interno de respuestas de una
# misma entrega (máximo efectivo 3). No limita peticiones HTTP simultáneas.
# Cada corrección tiene además un deadline total de 120 s, por debajo de Gunicorn.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Casilla que recibe el formulario de contacto. Vacía = contacto@maestria.test (simulada).
# Solo con EMAIL_HOST y esta variable definidas se usa SMTP; si no, el correo sale por consola.
CONTACT_NOTIFY_EMAIL=
