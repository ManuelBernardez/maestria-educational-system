# Backend Django (copiá este archivo como .env y completá los valores)
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-40-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# En local podés omitir DATABASE_URL para usar SQLite.
# Para Supabase, pegá la URI completa de Connect sin duplicar segmentos ni @.
# Si la contraseña contiene @, :, /, # o %, usa URL encoding.
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

AI_PROVIDER=mock
# Enable only after reviewing provider terms and informing users about external processing.
AI_EXTERNAL_PROCESSING_APPROVED=False
# Set True only after confirming the Gemini project is on the paid tier.
# The free tier may use submitted content to improve Google products.
AI_GEMINI_PAID_TIER_CONFIRMED=False
# Only for the evaluate_ai command using the included synthetic fixtures; never enables
# free-tier Gemini requests from normal app workflows.
AI_GEMINI_FREE_TIER_SYNTHETIC_EVAL=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENT_ANSWERS=3

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Notificación de contactos (opcional; el formulario funciona sin email de aviso)
CONTACT_NOTIFY_EMAIL=
