# MaestrIA — configuración local. Copiar como backend/.env y completar.
# En producción, cargar los mismos valores en el panel Environment del hosting.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# PostgreSQL de Supabase. Nunca subir esta URI ni su contraseña a Git.
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase Auth: URL y anon/publishable key son públicas; RLS debe estar bien configurado.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Secreto privado de firma JWT, solo si la validación configurada lo requiere.
SUPABASE_JWT_SECRET=

# Mismo origen en producción; estos orígenes se reservan para el preview local separado.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# IA: Gemini se invoca exclusivamente desde el backend.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=35
AI_EXTERNAL_PROCESSING_APPROVED=True
# Mantener True solo si verificaste que el proyecto de Google está en nivel pago.
AI_GEMINI_PAID_TIER_CONFIRMED=True
# False: no habilitar evaluaciones gratuitas con datos sintéticos en el servicio normal.
AI_GEMINI_FREE_TIER_SYNTHETIC_EVAL=False
AI_MAX_CONCURRENT_ANSWERS=3

# Proveedores alternativos (no necesarios para Gemini).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Correo opcional para notificaciones de contacto.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
